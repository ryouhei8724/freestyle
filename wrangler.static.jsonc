{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-table-format-guide",
  // account_id は公開リポジトリに置かないため省略。Workers Builds では接続先アカウント、
  // 手元からの wrangler deploy では CLOUDFLARE_ACCOUNT_ID 環境変数で指定する。
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
